# development | test | production — development/test auto-provision a fixed
# dev@local.test user with no real auth check.
ENVIRONMENT=development

# Local: Docker Postgres (see docker-compose.yml). Neon connection strings
# for dev/test/prod live only in your own .env, never committed.
DATABASE_URL=postgresql://portfolio:portfolio-dev-password@localhost:5433/portfolio

# Shared HMAC secret with the frontend's NextAuth jwt.encode/decode override.
# Must be the exact same value configured on the frontend.
NEXTAUTH_SECRET=

# Vercel frontend origin, for CORS (e.g. https://portfolio-manager.vercel.app)
FRONTEND_ORIGIN=http://localhost:3000

# Portfolio assistant agent (app/routers/agent.py, app/mcp_server.py).
# "gemini" or "claude" — app/services/llm/base.py's LLMProvider seam makes
# this a one-line switch, not a code change.
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
# Metadata URLs for the MCP server's protected-resource discovery — point
# these at this backend's own deployed base URL, not a real OAuth issuer.
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8000/mcp

# Company-fundamentals source for the value-investing agent tools.
# "yahoo" is the only provider today (yfinance, no API key). Results are
# cached in Postgres once per UTC day per symbol.
FUNDAMENTALS_PROVIDER=yahoo
